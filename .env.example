# Reference only. The working values live in .env, which IS committed so a
# fresh clone runs the demo with no setup. Put personal overrides in
# .env.local (gitignored) — it takes precedence over .env.

DATABASE_URL=postgresql:///brag_dev

# Demo mode — offers the "Mode Demo" choice on the landing page. Demo runs on
# an in-memory PGlite database. Set to false to hide the option entirely.
NEXT_PUBLIC_DEMO_MODE=true

# Quick tour voice-over (ElevenLabs). Server-side only.
# Free plans cannot use library/professional voices via the API — pick a
# premade voice id (e.g. EXAVITQu4vr4xnSDxMaL) or upgrade the plan. Without a
# usable voice the tour falls back to browser speech synthesis.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
