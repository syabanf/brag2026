# Committed on purpose so a fresh clone can run the demo with no setup.
# Personal overrides go in .env.local, which stays gitignored and wins over
# every value here.

# Demo mode: offers the "Mode Demo" choice on the landing page. The demo runs
# on an in-memory PGlite database. Set to false to hide the option (production).
NEXT_PUBLIC_DEMO_MODE=true

# Quick tour voice-over. Read server-side only — never sent to the browser.
ELEVENLABS_API_KEY=sk_66aa6205ff9fa32350219fa50c45c7af0a5b339afa54082c
ELEVENLABS_VOICE_ID=1k39YpzqXZn52BgyLyGO

# Note: the voice above is an ElevenLabs *professional* library voice, which
# free plans cannot use through the API (HTTP 402). Until the plan is upgraded
# the tour narrates with the browser's built-in speech synthesis. To get real
# ElevenLabs audio on a free plan, swap in a premade voice, e.g.:
#   ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL   # Sarah — neutral, clear

# Real PostgreSQL connection, used when signing in with an account instead of
# the demo. Override in .env.local if yours differs.
DATABASE_URL=postgresql:///brag_dev
