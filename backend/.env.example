# Required.
DATABASE_URL=postgresql://brag:brag@localhost:5433/brag_dev

PORT=8080

# Comma-separated. Cookies are credentialed, so "*" is not usable here — the
# Vite dev server origin must be listed explicitly.
ALLOWED_ORIGINS=http://localhost:5173

SESSION_COOKIE=brag_session

# Set true when serving over HTTPS so the session cookie is Secure.
COOKIE_SECURE=false

# Guided tour voice-over. Optional — without these the tour narrates with the
# browser's own speech synthesis. Note that free ElevenLabs plans cannot use
# library or professional voices through the API; pick a premade voice id.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
