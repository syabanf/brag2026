# Required.
DATABASE_URL=postgresql://brag:brag@localhost:5433/brag_dev

PORT=8080

# Comma-separated. Cookies are credentialed, so "*" is not usable here — the
# Vite dev server origin must be listed explicitly.
ALLOWED_ORIGINS=http://localhost:5173

SESSION_COOKIE=brag_session

# Set true when serving over HTTPS so the session cookie is Secure.
COOKIE_SECURE=false
